# Copy to .env.local and fill in. Free LiveKit Cloud project: https://cloud.livekit.io
# With LiveKit Inference, these three keys also cover STT, LLM and TTS.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Only needed if you swap to plugin instances with your own provider keys:
# DEEPGRAM_API_KEY=
# GOOGLE_API_KEY=
# ELEVEN_API_KEY=
